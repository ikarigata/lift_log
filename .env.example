# =============================================================================
# Environment Configuration Template - Lift Log
# =============================================================================
# IMPORTANT: Copy this file to .env and update the values for your environment
# DO NOT commit .env to version control
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your actual values
# =============================================================================

# Application Configuration
APP_NAME=lift_log

# Database Configuration (PostgreSQL)
POSTGRES_DB=lift_log
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password

# Database Connection URLs
DB_URL_LOCAL=jdbc:postgresql://localhost:5439/lift_log
DB_URL_DOCKER=jdbc:postgresql://db:5432/lift_log
DB_URL_TEST=jdbc:postgresql://localhost:5439/lift_log_test

# Server Configuration
SERVER_PORT=8080

# JWT Configuration (IMPORTANT: Generate secure values)
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_SECURE_RANDOM_STRING_MIN_64_CHARACTERS_LONG
JWT_EXPIRATION=24

# Frontend Configuration
VITE_API_BASE_URL=/api/v1
VITE_USE_MSW=false

# =============================================================================
# SETUP CHECKLIST
# =============================================================================
# [ ] Copy this file to .env
# [ ] Update POSTGRES_PASSWORD with your preferred secure password
# [ ] Generate and set a secure JWT_SECRET (minimum 64 characters)
# [ ] Ensure PostgreSQL is running on port 5439 (for local development)
# [ ] Run: docker-compose up -d
# =============================================================================