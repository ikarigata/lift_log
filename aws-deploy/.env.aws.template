# =============================================================================
# Environment Configuration - Lift Log (AWS Production)
# =============================================================================
# IMPORTANT: Copy this file to .env.aws and update the values for production
# DO NOT commit .env.aws to version control

# Application Configuration
APP_NAME=lift_log

# Database Configuration (PostgreSQL)
POSTGRES_DB=lift_log
POSTGRES_USER=lift_log_user
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_IN_PRODUCTION

# Database Connection URLs
DB_URL=jdbc:postgresql://db:5432/lift_log
DB_USERNAME=lift_log_user
DB_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_IN_PRODUCTION

# Server Configuration
SERVER_PORT=8080

# JWT Configuration (CRITICAL: Change in production)
JWT_SECRET=CHANGE_THIS_JWT_SECRET_KEY_TO_SECURE_RANDOM_STRING_MIN_256_BITS
JWT_EXPIRATION=24

# Frontend Configuration
VITE_API_BASE_URL=/api
VITE_USE_MSW=false

# SSL Configuration (Optional - for Let's Encrypt)
DOMAIN_NAME=your-domain.com
SSL_EMAIL=your-email@example.com

# =============================================================================
# PRODUCTION SETUP CHECKLIST
# =============================================================================
# [ ] Change POSTGRES_PASSWORD to a strong password
# [ ] Change JWT_SECRET to a secure random string (minimum 256 bits)
# [ ] Update DOMAIN_NAME if using custom domain
# [ ] Update SSL_EMAIL for Let's Encrypt certificates
# =============================================================================