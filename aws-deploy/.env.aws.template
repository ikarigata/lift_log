# =============================================================================
# AWS Environment Configuration Template
# =============================================================================
# IMPORTANT: Copy this file to .env.aws and update the values for production
# DO NOT commit .env.aws to version control

# Database Configuration (PostgreSQL in Docker)
POSTGRES_DB=lift_log
POSTGRES_USER=lift_log_user
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_IN_PRODUCTION

# Spring Boot Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/lift_log
SPRING_DATASOURCE_USERNAME=lift_log_user
SPRING_DATASOURCE_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_IN_PRODUCTION

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# JWT Configuration (CRITICAL: Change these in production)
JWT_SECRET=CHANGE_THIS_JWT_SECRET_KEY_TO_SECURE_RANDOM_STRING_MIN_256_BITS
JWT_EXPIRATION=24

# Frontend Configuration
VITE_API_BASE_URL=/api
VITE_USE_MSW=false

# SSL Configuration (Optional - for Let's Encrypt)
DOMAIN_NAME=your-domain.com
SSL_EMAIL=your-email@example.com

# AWS Specific Configuration
AWS_REGION=ap-northeast-1
ENVIRONMENT=production

# Backup Configuration
BACKUP_RETENTION_DAYS=7
BACKUP_S3_BUCKET=your-backup-bucket-name

# Monitoring Configuration (Optional)
ENABLE_CLOUDWATCH_LOGS=true
LOG_LEVEL=INFO

# Security Configuration
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com

# Database Connection Pool Settings
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=30000
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=600000
SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=1800000

# Application Performance Settings
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=false

# Logging Configuration
LOGGING_LEVEL_ROOT=WARN
LOGGING_LEVEL_COM_IKR_LIFT_LOG=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=WARN

# Health Check Configuration
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when_authorized

# Rate Limiting (handled by Nginx, but can be configured in app)
API_RATE_LIMIT_REQUESTS_PER_MINUTE=100
LOGIN_RATE_LIMIT_REQUESTS_PER_MINUTE=5

# =============================================================================
# PRODUCTION SECURITY CHECKLIST
# =============================================================================
# [ ] Change POSTGRES_PASSWORD to a strong password
# [ ] Change JWT_SECRET to a secure random string (minimum 256 bits)
# [ ] Update DOMAIN_NAME if using custom domain
# [ ] Update SSL_EMAIL for Let's Encrypt certificates
# [ ] Review and update CORS_ALLOWED_ORIGINS
# [ ] Enable monitoring if needed
# [ ] Test all endpoints after deployment
# [ ] Verify SSL certificate installation
# [ ] Check database backup functionality
# =============================================================================