# =============================================================================
# Environment Configuration - Lift Log (Local Development)
# =============================================================================

# Application Configuration
APP_NAME=lift_log

# Database Configuration (PostgreSQL)
POSTGRES_DB=lift_log
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Database Connection URLs
DB_URL=jdbc:postgresql://localhost:5439/lift_log
DB_URL_TEST=jdbc:postgresql://localhost:5439/lift_log_test
DB_URL_DOCKER=jdbc:postgresql://db:5432/lift_log
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Server Configuration
SERVER_PORT=8080
SERVER_TEST_PORT=8081

# JWT Configuration
JWT_SECRET=mySecretKey1234567890123456789012345678901234567890
JWT_EXPIRATION=24

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080
VITE_USE_MSW=false

# Port Configuration
FRONTEND_PORT=3000
FRONTEND_DOCKER_PORT=80