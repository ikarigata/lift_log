# =============================================================================
# Environment Configuration - Vol Log (Local Development)  
# =============================================================================

# Application Configuration
APP_NAME=vol_log

# Database Configuration (PostgreSQL)
POSTGRES_DB=vol_log
POSTGRES_USER=vol_log_user
POSTGRES_PASSWORD=vol_log_password

# Database Connection URLs
DB_URL_LOCAL=jdbc:postgresql://localhost:5439/vol_log
DB_URL_DOCKER=jdbc:postgresql://db:5432/vol_log
DB_URL_TEST=jdbc:postgresql://localhost:5439/vol_log_test

# Server Configuration
SERVER_PORT=8080

# JWT Configuration
JWT_SECRET=mySecretKey1234567890123456789012345678901234567890
JWT_EXPIRATION=24

# Frontend Configuration
VITE_API_BASE_URL=/api/v1
VITE_USE_MSW=false